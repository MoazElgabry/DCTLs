// Define structures for text rendering
 typedef struct {
     float x, y;  // Top-left position of a character or string
     float scale; // Height of the character relative to the image height
 } char_trans_t;
 
typedef struct {
    float x, y; // Current pixel position in normalized coordinates
    float aspect; // Display aspect ratio of the normalized drawing area
} curr_pos_t;
 
// Helper functions
 __DEVICE__ char_trans_t make_char_trans(float x, float y, float scale) {
    char_trans_t result = {};
    result.x = x;
    result.y = y;
    result.scale = scale;
    return result;
 }
 
 __DEVICE__ curr_pos_t make_curr_pos(float x, float y, float aspect) {
    curr_pos_t result = {};
    result.x = x;
    result.y = y;
    result.aspect = aspect;
    return result;
 }
 
__DEVICE__ float font_kerning_at(int left_glyph, int right_glyph) {
    int pair_index = left_glyph * FONT_LENGTH + right_glyph;
    int packed = font_kerning_packed[pair_index / FONT_KERNINGS_PER_INT];
    int shift = (pair_index % FONT_KERNINGS_PER_INT) * FONT_KERNING_BITS;
    int adjustment = (packed >> shift) & 63;
    if (adjustment >= 32) adjustment -= 64;
    return (float)adjustment / FONT_KERNING_SCALE;
}

__DEVICE__ float font_coverage_at(int glyph_index, int row, int col) {
    __CONSTANTREF__ int* packed_row = &font_bitmap[glyph_index][row][0];
    int packed = packed_row[col / FONT_PIXELS_PER_INT];
    int shift = (col % FONT_PIXELS_PER_INT) * FONT_COVERAGE_BITS;
    int coverage = (packed >> shift) & 7;
    return (float)coverage * (1.0f / 7.0f);
}

__DEVICE__ void draw_char(
    char c, float3 char_color, __PRIVATE__ char_trans_t* char_trans, __PRIVATE__ curr_pos_t* curr_pos, __PRIVATE__ float3* curr_color) {
    int char_code = (int)c;
    if (char_code < FONT_FIRST_CHAR || char_code >= FONT_FIRST_CHAR + FONT_LENGTH) char_code = 63;
    int glyph_index = char_code - FONT_FIRST_CHAR;
    float char_height = char_trans->scale;
    float char_width = char_trans->scale * FONT_WIDTH / FONT_HEIGHT / curr_pos->aspect;

    if (curr_pos->x < char_trans->x || curr_pos->x >= char_trans->x + char_width ||
        curr_pos->y < char_trans->y || curr_pos->y >= char_trans->y + char_height) return;

    float sample_x = (curr_pos->x - char_trans->x) / char_width * FONT_WIDTH;
    float sample_y = (curr_pos->y - char_trans->y) / char_height * FONT_HEIGHT;
    if (sample_x < 0.0f) sample_x = 0.0f;
    if (sample_y < 0.0f) sample_y = 0.0f;
    if (sample_x > (float)(FONT_WIDTH - 1)) sample_x = (float)(FONT_WIDTH - 1);
    if (sample_y > (float)(FONT_HEIGHT - 1)) sample_y = (float)(FONT_HEIGHT - 1);

    int x0 = (int)sample_x;
    int y0 = (int)sample_y;
    int x1 = x0 + 1;
    int y1 = y0 + 1;
    if (x1 >= FONT_WIDTH) x1 = FONT_WIDTH - 1;
    if (y1 >= FONT_HEIGHT) y1 = FONT_HEIGHT - 1;
    float tx = sample_x - (float)x0;
    float ty = sample_y - (float)y0;

    float top = font_coverage_at(glyph_index, y0, x0) * (1.0f - tx) + font_coverage_at(glyph_index, y0, x1) * tx;
    float bottom = font_coverage_at(glyph_index, y1, x0) * (1.0f - tx) + font_coverage_at(glyph_index, y1, x1) * tx;
    float alpha = top * (1.0f - ty) + bottom * ty;
    if (alpha <= 0.0f) return;

    float inverse_alpha = 1.0f - alpha;
    float3 background = *curr_color;
    *curr_color = make_float3(
        background.x * inverse_alpha + char_color.x * alpha,
        background.y * inverse_alpha + char_color.y * alpha,
        background.z * inverse_alpha + char_color.z * alpha);
}

__DEVICE__ void draw_string(
    char str[], float3 str_color, __PRIVATE__ char_trans_t* char_trans, __PRIVATE__ curr_pos_t* curr_pos, __PRIVATE__ float3* curr_color) {
    int i = 0;
    char c = str[0];
    float pen_x = char_trans->x;
    char_trans_t c_trans = *char_trans;
    while (c != '\0' && c != 0) {
        int char_code = (int)c;
        if (char_code < FONT_FIRST_CHAR || char_code >= FONT_FIRST_CHAR + FONT_LENGTH) char_code = 63;
        int glyph_index = char_code - FONT_FIRST_CHAR;
        c_trans.x = pen_x + c_trans.scale * font_left_bearings[glyph_index] / FONT_HEIGHT / curr_pos->aspect;
        draw_char((char)char_code, str_color, &c_trans, curr_pos, curr_color);
        pen_x += c_trans.scale * font_widths[glyph_index] / FONT_HEIGHT / curr_pos->aspect;
        i++;
        c = str[i];
        if (c != '\0' && c != 0) {
            int next_code = (int)c;
            if (next_code < FONT_FIRST_CHAR || next_code >= FONT_FIRST_CHAR + FONT_LENGTH) next_code = 63;
            int next_glyph_index = next_code - FONT_FIRST_CHAR;
            pen_x += c_trans.scale * font_kerning_at(glyph_index, next_glyph_index) / FONT_HEIGHT / curr_pos->aspect;
        }
    }
}

__DEVICE__ float string_width_in_units(char str[], float scale, float aspect);

__DEVICE__ float3 draw_quantization_plot(float x, float y, int width, int height, int num_steps, int bit_depth, float mid_gray_value, int TF, char curve_info[], float text_aspect) {
    const float plot_left = 0.08f;
    const float plot_right = 0.92f;
    const float code_top = 0.12f;
    const float code_bottom = 0.56f;
    const float error_top = 0.70f;
    const float error_bottom = 0.91f;
    const float3 background = make_float3(0.025f, 0.03f, 0.04f);
    const float3 grid_color = make_float3(0.13f, 0.15f, 0.17f);
    const float3 ideal_color = make_float3(0.9f, 0.9f, 0.9f);
    const float3 quantized_color = make_float3(1.0f, 0.55f, 0.12f);
    const float3 error_color = make_float3(0.25f, 1.0f, 0.3f);
    const float3 clipped_color = make_float3(1.0f, 0.1f, 0.65f);
    const float3 mid_gray_color = make_float3(0.12f, 0.78f, 0.95f);
    float middle_step = (float)(num_steps / 2);
    float mid_gray_axis_x = plot_left + ((middle_step + 0.5f) / (float)num_steps) * (plot_right - plot_left);
    float mid_gray_x_tolerance = 1.5f / (float)width;
    float3 output = background;

    if (x >= plot_left && x <= plot_right) {
        float stops = (x - plot_left) / (plot_right - plot_left) * (float)num_steps - 0.5f - middle_step;
        float linear_value = _fmaxf(mid_gray_value, 0.000001f) * _exp2f(stops);
        float encoded = LinToTF(make_float3(linear_value, linear_value, linear_value), TF).x;
        float quantized = quantize(make_float3(encoded, encoded, encoded), 0, bit_depth).x;
        float reconstructed = Linearize(make_float3(quantized, quantized, quantized), TF).x;
        float error_stops = reconstructed > 0.00000001f ? _log2f(reconstructed / linear_value) : -1.0f;
        float code_height = code_bottom - code_top;
        float ideal_y = code_bottom - _saturatef(encoded) * code_height;
        float quantized_y = code_bottom - quantized * code_height;
        float zero_y = (error_top + error_bottom) * 0.5f;
        float error_half_height = (error_bottom - error_top) * 0.5f;
        float error_y = zero_y - _fmaxf(-1.0f, _fminf(error_stops, 1.0f)) * error_half_height;
        float line_tolerance = _fmaxf(1.5f / (float)height, 0.0015f);
        float stop_grid = _fabs(stops - _round(stops));
        float code_grid = _fabs((code_bottom - y) / code_height * 4.0f - _round((code_bottom - y) / code_height * 4.0f));
        float error_grid = _fabs(y - zero_y);
        float error_half_grid = _fabs(_fabs(y - zero_y) - error_half_height * 0.5f);

        if (y >= code_top && y <= code_bottom) {
            if (stop_grid < 0.025f || code_grid < 0.035f) output = grid_color;
            if (_fabs(x - mid_gray_axis_x) < mid_gray_x_tolerance) output = mid_gray_color;
            if (_fabs(y - ideal_y) < line_tolerance) output = ideal_color;
            if (_fabs(y - quantized_y) < line_tolerance) output = quantized_color;
            if ((encoded < 0.0f || encoded > 1.0f) && _fabs(y - (code_top + 0.008f)) < line_tolerance) output = clipped_color;
        } else if (y >= error_top && y <= error_bottom) {
            if (error_grid < line_tolerance || error_half_grid < line_tolerance || stop_grid < 0.025f) output = grid_color;
            if (_fabs(x - mid_gray_axis_x) < mid_gray_x_tolerance) output = mid_gray_color;
            if (_fabs(y - error_y) < line_tolerance) output = error_color;
            if ((encoded < 0.0f || encoded > 1.0f || reconstructed <= 0.0f) && _fabs(y - error_y) < line_tolerance) output = clipped_color;
        }
    }

    if (y >= code_top - 0.007f && y < code_top) {
        float marker_half_width = (code_top - y);
        if (_fabs(x - mid_gray_axis_x) < marker_half_width) output = mid_gray_color;
    }

    curr_pos_t curr_pos = make_curr_pos(x, y, text_aspect);
    char header[] = "REFERENCE AND QUANTIZED CODE VALUES";
    char mid_gray_label[] = "0 STOPS";
    char error_header[] = "RECONSTRUCTION ERROR (STOPS)";
    char unquantized_legend[] = "UNQUANTIZED";
    char quantized_legend[] = "QUANTIZED";
    char clipped_legend[] = "CLIPPED";
    char positive_one[] = "+1";
    char zero[] = "0";
    char negative_one[] = "-1";
    char x_axis[] = "EXPOSURE (STOPS FROM MID-GRAY)";
    float mid_gray_label_scale = 0.015f;
    float mid_gray_label_width = string_width_in_units(mid_gray_label, mid_gray_label_scale, text_aspect);
    char_trans_t header_trans = make_char_trans(plot_left, 0.035f, 0.032f);
    char_trans_t curve_info_trans = make_char_trans(plot_left, 0.082f, 0.022f);
    char_trans_t mid_gray_label_trans = make_char_trans(mid_gray_axis_x - mid_gray_label_width * 0.5f, 0.100f, mid_gray_label_scale);
    char_trans_t error_trans = make_char_trans(plot_left, 0.625f, 0.028f);
    float legend_scale = 0.023f;
    float legend_gap = 0.018f;
    float unquantized_width = string_width_in_units(unquantized_legend, legend_scale, text_aspect);
    float quantized_width = string_width_in_units(quantized_legend, legend_scale, text_aspect);
    float clipped_width = string_width_in_units(clipped_legend, legend_scale, text_aspect);
    float legend_group_width = unquantized_width + quantized_width + clipped_width + 2.0f * legend_gap;
    float legend_left = plot_right - legend_group_width;
    char_trans_t unquantized_trans = make_char_trans(legend_left, 0.055f, legend_scale);
    char_trans_t quantized_trans = make_char_trans(legend_left + unquantized_width + legend_gap, 0.055f, legend_scale);
    char_trans_t clipped_trans = make_char_trans(legend_left + unquantized_width + legend_gap + quantized_width + legend_gap, 0.055f, legend_scale);
    char_trans_t positive_one_trans = make_char_trans(0.04f, error_top, 0.022f);
    char_trans_t zero_trans = make_char_trans(0.04f, (error_top + error_bottom) * 0.5f, 0.022f);
    char_trans_t negative_one_trans = make_char_trans(0.04f, error_bottom - 0.022f, 0.022f);
    float x_axis_scale = 0.023f;
    float x_axis_width = string_width_in_units(x_axis, x_axis_scale, text_aspect);
    char_trans_t x_axis_trans = make_char_trans(0.5f - x_axis_width * 0.5f, 0.945f, x_axis_scale);
    draw_string(header, make_float3(0.9f, 0.9f, 0.9f), &header_trans, &curr_pos, &output);
    draw_string(curve_info, make_float3(0.75f, 0.82f, 0.9f), &curve_info_trans, &curr_pos, &output);
    draw_string(mid_gray_label, mid_gray_color, &mid_gray_label_trans, &curr_pos, &output);
    draw_string(error_header, make_float3(0.9f, 0.9f, 0.9f), &error_trans, &curr_pos, &output);
    draw_string(unquantized_legend, ideal_color, &unquantized_trans, &curr_pos, &output);
    draw_string(quantized_legend, quantized_color, &quantized_trans, &curr_pos, &output);
    draw_string(clipped_legend, clipped_color, &clipped_trans, &curr_pos, &output);
    draw_string(positive_one, make_float3(0.75f, 0.75f, 0.75f), &positive_one_trans, &curr_pos, &output);
    draw_string(zero, make_float3(0.75f, 0.75f, 0.75f), &zero_trans, &curr_pos, &output);
    draw_string(negative_one, make_float3(0.75f, 0.75f, 0.75f), &negative_one_trans, &curr_pos, &output);
    draw_string(x_axis, make_float3(0.75f, 0.75f, 0.75f), &x_axis_trans, &curr_pos, &output);
    return output;
}

 __DEVICE__ float string_width_in_units(char str[], float scale, float aspect) {
    float width = 0.0f;
    int i = 0;
    char c = str[i];
    while (c != '\0' && c != 0) {
        int char_code = (int)c;
        if (char_code < FONT_FIRST_CHAR || char_code >= FONT_FIRST_CHAR + FONT_LENGTH) char_code = 63;
        int glyph_index = char_code - FONT_FIRST_CHAR;
        width += scale * font_widths[glyph_index] / FONT_HEIGHT / aspect;
        i++;
        c = str[i];
        if (c != '\0' && c != 0) {
            int next_code = (int)c;
            if (next_code < FONT_FIRST_CHAR || next_code >= FONT_FIRST_CHAR + FONT_LENGTH) next_code = 63;
            int next_glyph_index = next_code - FONT_FIRST_CHAR;
            width += scale * font_kerning_at(glyph_index, next_glyph_index) / FONT_HEIGHT / aspect;
        }
    }
    return width;
}

 __DEVICE__ int strlen(char a[]) {
    int i = 0;
    while (a[i] != '\0' && a[i] != 0) {
        ++i;
    }
    return i;
 }
 
 __DEVICE__ void strcpy_idx(char str_src[], char str_dst[], int src_start_idx, int dst_start_idx, int num_chars) {
    for (int i = 0; i < num_chars; ++i) {
        str_dst[dst_start_idx + i] = str_src[src_start_idx + i];
    }
 }
 
 __DEVICE__ void strcpy(char dest[], char src[]) {
    int i = 0;
    while (src[i] != '\0' && i < 64) { // Assuming max length of 64
        dest[i] = src[i];
        i++;
    }
    dest[i] = '\0';
 }
 
  
 __DEVICE__ void strcat(char a[], char b[], char dest[]) {
     int len_a = strlen(a);
     int len_b = strlen(b);
     if (a != dest) {
         strcpy_idx(a, dest, 0, 0, len_a);
     }
     strcpy_idx(b, dest, 0, len_a, len_b);
     dest[len_a + len_b] = '\0';
 }

 
 __DEVICE__ char digit2char(int i) {
    return (char)('0' + i);
 }
 
 __DEVICE__ void int2str(int value, char output[], int num_chars) {
    int runner = 0;

    if (value < 0) {
        output[runner++] = '-';
        value = -value;
    } else if (value == 0) {
        output[runner++] = '0';
        output[runner] = '\0';
        return;
    }

    int temp = value;
    int digits = 0;
    while (temp > 0) {
        temp /= 10;
        digits++;
    }

    for (int i = digits - 1; i >= 0 && runner < num_chars - 1; i--) {
        int divisor = (int)_powf(10.0f, i);
        int digit = value / divisor;
        output[runner++] = digit2char(digit);
        value %= divisor;
    }
    output[runner] = '\0';
 }
 
 __DEVICE__ void int2str_signed(int value, char output[]) {
    int runner = 0;
    if (value < 0) {
        output[runner++] = '-';
        value = -value;
    } else if (value > 0) {
        output[runner++] = '+';
    } else {
        output[runner++] = '0';
        output[runner] = '\0';
        return;
    }

    int temp = value;
    int digits = 0;
    while (temp > 0) {
        temp /= 10;
        digits++;
    }

    for (int i = digits - 1; i >= 0; i--) {
        int divisor = (int)_powf(10.0f, i);
        int digit = value / divisor;
        output[runner++] = digit2char(digit);
        value %= divisor;
    }
    output[runner] = '\0';
 }
 
 
