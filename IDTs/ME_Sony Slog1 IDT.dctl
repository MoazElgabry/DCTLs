/*
Custom Input color transform from Sony Slog / S-Gamut
written by Moazelgabry. moazelgabry.com

*/
typedef struct {
        float3 x, y, z;
} float3x3;

__DEVICE__ float3x3 make_float3x3(float3 a, float3 b, float3 c) {
    float3x3 d;
    d.x = a, d.y = b, d.z = c;
    return d;
}

// Matrix-vector multiplication for gamut conversion.
__DEVICE__ float3 mult_f33_f3(float3x3 m, float3 a){
  return make_float3( m.x.x * a.x + m.x.y * a.y + m.x.z * a.z,
            m.y.x * a.x + m.y.y * a.y + m.y.z * a.z,
            m.z.x * a.x + m.z.y * a.y + m.z.z * a.z);
}



// Linear RGB <-> CIE XYZ D65 matrices. Sony's S-Gamut matrix is from the
// F65 operation manual; DaVinci Wide Gamut is from Blackmagic's specification.
#define matrix_sgamut_to_xyz make_float3x3(make_float3(0.7064827131923f, 0.1288010497906f, 0.1151721640688f), make_float3(0.2709796708135f, 0.7866064112209f, -0.0575860820344f), make_float3(-0.0096778453862f, 0.0046000374925f, 1.0941355586536f))
#define matrix_xyz_to_sgamut make_float3x3(make_float3(1.507399899060f, -0.245822137385f, -0.171611680816f), make_float3(-0.518151727083f, 1.355391240902f, 0.125878668162f), make_float3(0.015511698158f, -0.007872771427f, 0.911916365575f))
#define matrix_dwg_to_xyz make_float3x3(make_float3(0.7006223202f, 0.1487748027f, 0.1010587290f), make_float3(0.2741184831f, 0.8736317754f, -0.1477504224f), make_float3(-0.0989629030f, -0.1378953159f, 1.3259160519f))
#define matrix_xyz_to_dwg make_float3x3(make_float3(1.51667220f, -0.28147809f, -0.14696366f), make_float3(-0.46491717f, 1.25142396f, 0.17488464f), make_float3(0.06484904f, 0.10913935f, 0.76141459f))
#define matrix_xyz_to_awg3 make_float3x3(make_float3(1.78906555097f, -0.482533863771f, -0.200075792936f), make_float3(-0.639848659902f, 1.39639995686f, 0.194432291778f), make_float3(-0.041531545853f, 0.082335373554f, 0.878868480293f))
#define matrix_awg3_to_xyz make_float3x3(make_float3(0.638007619285f, 0.214703856338f, 0.097744451431f), make_float3(0.291953779001f, 0.823841041511f, -0.115794820510f), make_float3(0.002798279032f, -0.067034235689f, 1.153293707417f))

__DEVICE__ float3 inline oetf_sony_slog2(float3 x, int inv) {
  /* Sony S-Log2
      from the pdf originally retrieved from :
      https://pro.sony/ue_US/?sonyref=pro.sony.com/bbsccms/assets/files/micro/dmpc/training/S-Log2_Technical_PaperV1_0.pdf
      Link is down, here is a mirror:
      https://mega.nz/file/e6hDxC5b#YaRzePfGFFPkx_hRtmqw2gTT0NIPuzlJycwCP38H720
  */
    const float c0 = 0.432699f;
    const float c1 = 155.0f;
    const float c2 = 219.0f;
    const float c3 = 0.037584f;
    const float c4 = 0.616596f;
    const float c5 = 0.03f;
    const float c6 = 3.53881278538813f;
    const float c7 = 0.030001222851889303f;

    float3 result;

    if (inv == 1) {
        // Inverse transformation
        float3 normalized = (x - (64.0f / 1023.0f)) / (876.0f / 1023.0f);
        result.x = (normalized.x < c7) ? (normalized.x - c7) / c6
                                       : c2 * (_exp10f((normalized.x - c4 - c5) / c0) - c3) / c1;
        result.y = (normalized.y < c7) ? (normalized.y - c7) / c6
                                       : c2 * (_exp10f((normalized.y - c4 - c5) / c0) - c3) / c1;
        result.z = (normalized.z < c7) ? (normalized.z - c7) / c6
                                       : c2 * (_exp10f((normalized.z - c4 - c5) / c0) - c3) / c1;
        result = result * 0.9f;
    } else {
        // Forward transformation
        float3 scaled = x / 0.9f;
        result.x = (scaled.x < 0.0f) ? scaled.x * c6 + c7
                                     : (c0 * _log10f(c1 * scaled.x / c2 + c3) + c4) + c5;
        result.y = (scaled.y < 0.0f) ? scaled.y * c6 + c7
                                     : (c0 * _log10f(c1 * scaled.y / c2 + c3) + c4) + c5;
        result.z = (scaled.z < 0.0f) ? scaled.z * c6 + c7
                                     : (c0 * _log10f(c1 * scaled.z / c2 + c3) + c4) + c5;
        result = result * (876.0f / 1023.0f) + (64.0f / 1023.0f);
    }

    return result;
  }
 __DEVICE__ float3 inline oetf_davinci_intermediate(float3 x, int inv) {
    /* DaVinci Intermediate Log OETF and Inverse OETF
       Reference:
       https://documents.blackmagicdesign.com/InformationNotes/DaVinci_Resolve_17_Wide_Gamut_Intermediate.pdf
    */

    // Constants as per DaVinci Intermediate Log specification
    const float A = 0.0075f;
    const float B = 7.0f;
    const float C = 0.07329248f;
    const float M = 10.44426855f;
    const float LIN_CUT = 0.00262409f;
    const float LOG_CUT = 0.02740668f;

    float3 result;
    
    if (inv == 1) {
        // **Inverse Transformation (Log to Linear)**
        
        // Step 1: Apply piecewise transformation to each component
        // If x <= LOG_CUT, apply linear scaling: x / M
        // Else, apply exponential scaling: exp2(x / C - B) - A
        result.x = (x.x <= LOG_CUT) ? (x.x / M) : (_exp2f(x.x / C - B) - A);
        result.y = (x.y <= LOG_CUT) ? (x.y / M) : (_exp2f(x.y / C - B) - A);
        result.z = (x.z <= LOG_CUT) ? (x.z / M) : (_exp2f(x.z / C - B) - A);
    }
    else {
        // **Forward Transformation (Linear to Log)**
        
        // Step 1: Apply piecewise transformation to each component
        // If x <= LIN_CUT, apply linear scaling: x * M
        // Else, apply logarithmic scaling: (log2(x + A) + B) * C
        result.x = (x.x <= LIN_CUT) ? (x.x * M) : ((_log2f(x.x + A) + B) * C);
        result.y = (x.y <= LIN_CUT) ? (x.y * M) : ((_log2f(x.y + A) + B) * C);
        result.z = (x.z <= LIN_CUT) ? (x.z * M) : ((_log2f(x.z + A) + B) * C);
    }
    
    return result;
  }
 __DEVICE__ float3 inline oetf_arri_logc3(float3 x, int inv) {
    /* Arri Alexa LogC3 
       Formerly known as Alexa V3LogC EI800
       https://www.arri.com/resource/blob/31918/66f56e6abb6e5b6553929edf9aa7483e/2017-03-alexa-logc-curve-in-vfx-data.pdf
    */
    const float cut = 0.010591f;
    const float a = 5.555556f;
    const float b = 0.052272f;
    const float c = 0.247190f;
    const float d = 0.385537f;
    const float e = 5.367655f;
    const float f = 0.092809f;

    float3 result;

    if (inv == 1) {
        // **Inverse Transformation**
        // Apply the inverse OETF to each channel
        if (x.x < e * cut + f) {
            result.x = (x.x - f) / e;
        } else {
            result.x = (_exp10f((x.x - d) / c) - b) / a;
        }

        if (x.y < e * cut + f) {
            result.y = (x.y - f) / e;
        } else {
            result.y = (_exp10f((x.y - d) / c) - b) / a;
        }

        if (x.z < e * cut + f) {
            result.z = (x.z - f) / e;
        } else {
            result.z = (_exp10f((x.z - d) / c) - b) / a;
        }
    } else {
        // **Forward Transformation**
        // Apply the forward OETF to each channel
        if (x.x < cut) {
            result.x = e * x.x + f;
        } else {
            result.x = c * _log10f(a * x.x + b) + d;
        }

        if (x.y < cut) {
            result.y = e * x.y + f;
        } else {
            result.y = c * _log10f(a * x.y + b) + d;
        }

        if (x.z < cut) {
            result.z = e * x.z + f;
        } else {
            result.z = c * _log10f(a * x.z + b) + d;
        }
    }

    return result;
  }

__DEVICE__ float inline slog1_encode(float t) {
    return (0.432699f * _log10f(t + 0.037584f) + 0.616596f) + 0.03f;
}
__DEVICE__ float inline slog1_decode(float t) {
    return _powf(10.0f, (t - 0.616596f - 0.03f) / 0.432699f) - 0.037584f;
}
// Input and output gamut and transfer curve are independently selectable.
DEFINE_UI_PARAMS(bypass, Bypass, DCTLUI_CHECK_BOX, 0)
DEFINE_UI_PARAMS(input_gamut, Input Gamut, DCTLUI_COMBO_BOX, 0, {input_sgamut, input_dwg, input_xyz_d65, input_awg3}, {Sony S-Gamut, DaVinci Wide Gamut, CIE XYZ D65, ARRI Wide Gamut 3})
DEFINE_UI_PARAMS(input_curve, Input Curve, DCTLUI_COMBO_BOX, 1, {input_linear, input_slog1, input_slog2, input_davinci_intermediate, input_logc3_ei800}, {Linear, Sony S-Log1, Sony S-Log2, DaVinci Intermediate, ARRI LogC3 EI 800})
DEFINE_UI_PARAMS(output_gamut, Output Gamut, DCTLUI_COMBO_BOX, 0, {output_sgamut, output_dwg, output_xyz_d65, output_awg3}, {Sony S-Gamut, DaVinci Wide Gamut, CIE XYZ D65, ARRI Wide Gamut 3})
DEFINE_UI_PARAMS(output_curve, Output Curve, DCTLUI_COMBO_BOX, 2, {output_linear, output_slog1, output_slog2, output_davinci_intermediate, output_logc3_ei800}, {Linear, Sony S-Log1, Sony S-Log2, DaVinci Intermediate, ARRI LogC3 EI 800})

__DEVICE__ float3 decode_curve(float3 value, int curve) {
    if (curve == 1) {
        value.x = slog1_decode(value.x);
        value.y = slog1_decode(value.y);
        value.z = slog1_decode(value.z);
    } else if (curve == 2) {
        value = oetf_sony_slog2(value, 1);
    } else if (curve == 3) {
        value = oetf_davinci_intermediate(value, 1);
    } else if (curve == 4) {
        value = oetf_arri_logc3(value, 1);
    }
    return value;
}

__DEVICE__ float3 encode_curve(float3 value, int curve) {
    if (curve == 1) {
        value.x = slog1_encode(value.x);
        value.y = slog1_encode(value.y);
        value.z = slog1_encode(value.z);
    } else if (curve == 2) {
        value = oetf_sony_slog2(value, 0);
    } else if (curve == 3) {
        value = oetf_davinci_intermediate(value, 0);
    } else if (curve == 4) {
        value = oetf_arri_logc3(value, 0);
    }
    return value;
}

__DEVICE__ float3 gamut_to_xyz(float3 value, int gamut) {
    if (gamut == 0) return mult_f33_f3(matrix_sgamut_to_xyz, value);
    if (gamut == 1) return mult_f33_f3(matrix_dwg_to_xyz, value);
    if (gamut == 3) return mult_f33_f3(matrix_awg3_to_xyz, value);
    return value; // CIE XYZ D65
}

__DEVICE__ float3 xyz_to_gamut(float3 value, int gamut) {
    if (gamut == 0) return mult_f33_f3(matrix_xyz_to_sgamut, value);
    if (gamut == 1) return mult_f33_f3(matrix_xyz_to_dwg, value);
    if (gamut == 3) return mult_f33_f3(matrix_xyz_to_awg3, value);
    return value; // CIE XYZ D65
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B) {
    float3 value = make_float3(p_R, p_G, p_B);
    if (bypass) return value;

    // Decode in the declared input RGB space, route through XYZ D65, then
    // encode in the declared output RGB space.
    value = decode_curve(value, input_curve);
    value = gamut_to_xyz(value, input_gamut);
    value = xyz_to_gamut(value, output_gamut);
    return encode_curve(value, output_curve);
}
